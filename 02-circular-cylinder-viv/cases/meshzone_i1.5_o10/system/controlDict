FoamFile
{
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}

application     foamRun;
solver          movingMesh;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         0.35;
deltaT          0.0025;

writeControl    runTime;
writeInterval   0.35;
purgeWrite      0;
writeFormat     ascii;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   8;
runTimeModifiable true;
